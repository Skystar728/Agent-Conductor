# Telegram Bot Configuration
BOTTOKEN=your_telegram_bot_token_here

# Train Account Credentials
TRAIN_USERID=your_train_account_id_here
TRAIN_USERPW=your_train_account_password_here
# Legacy aliases: USERID, USERPW

# User Access Control (comma-separated phone numbers)
# Leave empty to allow all users
ALLOW_LIST=010-1234-5678,010-9876-5432

# Master Login Allowed Users (Comma-separated Telegram chat IDs or phone numbers)
# Only specified users can trigger "마스터로그인" auto-login
MASTER_USER_LIST=your_telegram_chat_id

# Redis Configuration (don't change host/port if using docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Optional Redis password (if set, redis container uses --requirepass and requires auth)
# REDIS_PASSWORD=your_secure_redis_password

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=False

# Payment Timeout (minutes) & reminder interval (seconds)
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_REMINDER_INTERVAL=30

# AI Gateway Configuration: 'none', 'openai', 'omniroute', 'custom'
# Compatible with any standard OpenAI-format endpoint (OpenAI, Ollama, Groq, vLLM, OmniRoute, etc.)
# Default is 'none' (deterministic safety mode, no LLM required).
AI_GATEWAY=none

# Optional: To use OpenAI or any OpenAI SDK compatible provider:
# AI_GATEWAY=openai
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: To use local Docker OmniRoute gateway (see .env.omniroute.example):
# AI_GATEWAY=omniroute
# OPENAI_BASE_URL=http://omniroute:20128/v1
# OPENAI_API_KEY=local-internal-key
# OPENAI_MODEL=cl/google/gemma-4-31b-it:free

# Traffic Pacing & Safety Circuit Breakers (seconds)
# TRAIN_SEARCH_MIN_INTERVAL: 최소 탐색 주기 (지터 하한)
TRAIN_SEARCH_MIN_INTERVAL=3.0
# TRAIN_SEARCH_MAX_INTERVAL: 최대 탐색 주기 (지터 상한)
TRAIN_SEARCH_MAX_INTERVAL=5.5
# (Legacy aliases: KORAIL_SEARCH_MIN_INTERVAL, KORAIL_SEARCH_MAX_INTERVAL)
# RATE_LIMIT_COOLDOWN_SECONDS: HTTP 429 또는 일시 혼잡 시 쿨다운
RATE_LIMIT_COOLDOWN_SECONDS=10
# WAF_COOLDOWN_SECONDS: HTTP 403 / 모바일 방화벽 제한 시 1차 서킷 브레이커 대기 시간
WAF_COOLDOWN_SECONDS=180
# WAF_MAX_CONSECUTIVE_BLOCKS: 연속 차단 감지 시 프로세스 강제 보호 종료 기준 횟수
WAF_MAX_CONSECUTIVE_BLOCKS=2
# MAINTENANCE_CHECK_MIN_INTERVAL / MAX_INTERVAL: 서버 정기 점검 시 상태 프로브 주기
MAINTENANCE_CHECK_MIN_INTERVAL=180
MAINTENANCE_CHECK_MAX_INTERVAL=300

# Optional custom secret for encrypting korail_pw in Redis (Fernet key)
# If empty, automatically derived from BOTTOKEN.
# ENCRYPTION_KEY=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
