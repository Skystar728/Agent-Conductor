# Copy this file to .env.omniroute and replace every value before first start.
# Keep this file local; it contains the secrets used by the OmniRoute dashboard.

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Generate with: openssl rand -hex 32
API_KEY_SECRET=

# Generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# Generate with: openssl rand -base64 48
OMNIROUTE_WS_BRIDGE_SECRET=

# Change before first dashboard login.
INITIAL_PASSWORD=
